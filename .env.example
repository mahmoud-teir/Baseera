# Copy to .env.local (never commit real values). Only EXPO_PUBLIC_* values reach the app bundle,
# so never put a service-role key or other secret here.

# Supabase project (Settings → API). The anon key is public by design; row-level security protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Show the prototype's clearly-labelled demo books/recordings (dev & staging only).

# Public site URL used for certificate verification links and auth redirects.
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# Per-ayah recitation CDN (EveryAyah format: {base}/{reciter}/{SSS}{AAA}.mp3)
EXPO_PUBLIC_RECITATION_CDN=https://everyayah.com/data

# Build variant for app.config.ts: development | staging | production
APP_VARIANT=development
