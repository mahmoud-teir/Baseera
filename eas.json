{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.20.0",
      "env": { "EXPO_PUBLIC_DEMO_CONTENT": "false" }
    },
    "development": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_DEMO_CONTENT": "true" },
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "ios": { "simulator": true, "buildConfiguration": "Debug" }
    },
    "simulator": {
      "extends": "base",
      "env": { "APP_VARIANT": "staging", "EXPO_PUBLIC_DEMO_CONTENT": "true" },
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "env": { "APP_VARIANT": "staging", "EXPO_PUBLIC_DEMO_CONTENT": "true" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "android": { "track": "internal", "releaseStatus": "draft" },
      "ios": {}
    }
  }
}
